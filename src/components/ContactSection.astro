---
import ContactForm from './ContactForm.astro';
import { business } from '../data/site.js';
const { heading = 'h2' } = Astro.props;
const H = heading;
---
<div class="contact-grid">
  <div class="contact-info">
    <span class="eyebrow">Free in-home consultation</span>
    <H>Let's Discuss Your Next Project</H>
    <p class="lead">Fill out the form, or call us to set up a free in-home consultation.</p>
    <dl>
      <div><dt>Phone</dt><dd><a href={business.phoneHref}>{business.phone}</a></dd></div>
      <div><dt>Email</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd></div>
      <div><dt>Service Areas</dt><dd>{business.serviceAreas.join(', ')}</dd></div>
    </dl>
  </div>
  <ContactForm />
</div>
